Algoritmo syn
	Definir S Como Caracter
	Definir N Como Caracter
	Definir resp Como Caracter
	
	Repetir 
		Mostrar "¿Desea repetir el pseudocodigo?"
		Mostrar " > S  > N"
		Leer resp
		Si resp = S
			Mostrar "¿Desea repetir el pseudocodigo?"
			Mostrar " > S  > N"
			Leer resp
		FinSi
	Hasta Que resp = "N"
	
FinAlgoritmo
