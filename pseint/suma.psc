Algoritmo suma
	Definir n1 Como Real
	Definir n2 Como Real
	Definir n Como Real
	
	Mostrar "Ingresa dos números a sumar para ver si el resultado es positivo, negativo o real"
	Mostrar "Ingrese el primer número:"
	Leer n1
	Mostrar "Ingrese el segundo número:"
	Leer n2
	
	n <- n1+n2 
	
	Mostrar n1 "+" n2 
	Mostrar n1 + n2
	
	Si n = 0 Entonces
		Mostrar "El resultado es igual a 0"
	FinSi
	Si n > 0 Entonces
		Mostrar "El resultado es positivo"
	FinSi
	Si n < 0 Entonces
		Mostrar "El resultado es negativo"
	FinSi
	
FinAlgoritmo
