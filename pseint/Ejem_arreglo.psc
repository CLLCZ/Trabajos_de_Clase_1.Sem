Algoritmo Ejem_arreglo
	// Declarar arreglo
	Dimension nombres[5]
	// Valores arreglo
	nombres[1] = "Ana"
	nombres[2] = "Jose"
	nombres[3] = "Maria"
	nombres[4] = "Pedro"
	nombres[5] = "Sonia"
	// Recorrer el arreglo
	Para i=1 Hasta 5 Con Paso 1 Hacer
		Mostrar "nombres[",i,"]", nombres[i]
	FinPara
	
	
FinAlgoritmo
